# Replace this before first start. Do not commit the real value.
N8N_ENCRYPTION_KEY=generate-a-long-random-value

# Local defaults. Change these when deploying behind HTTPS.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Karachi

# Execution retention limits sensitive support data stored by n8n.
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
