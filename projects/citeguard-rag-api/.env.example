# The offline extractive mode requires no secrets.
CITEGUARD_HOST=0.0.0.0
CITEGUARD_PORT=8080
CITEGUARD_KNOWLEDGE_DIR=knowledge
CITEGUARD_TOP_K=4
CITEGUARD_MIN_SCORE=0.12
CITEGUARD_REDACT_PII=true

# Optional OpenAI-compatible Chat Completions provider.
# CITEGUARD_LLM_BASE_URL=https://api.openai.com/v1
# CITEGUARD_LLM_API_KEY=replace-me
# CITEGUARD_LLM_MODEL=your-model-name
# CITEGUARD_LLM_TIMEOUT_SECONDS=20

